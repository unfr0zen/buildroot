/dts-v1/;
#include "omap36xx.dtsi"
#include <dt-bindings/input/input.h>
/ {
 model = "Nest J49 homebrew";
 compatible = "nestlabs,j49", "ti,omap3630", "ti,omap3";
 memory@80000000 { device_type = "memory"; reg = <0x80000000 0x04000000>; };
 chosen { stdout-path = &uart1; };
};
&uart1 { status = "okay"; };
&i2c1 {
 clock-frequency = <100000>;
 twl: twl@48 {
  reg = <0x48>;
  interrupts = <7>;
  interrupt-parent = <&intc>;
 };
};
#include "twl4030.dtsi"
&gpmc {
 ranges = <0 0 0x30000000 0x1000000>;
 nand@0,0 {
  compatible = "ti,omap2-nand";
  reg = <0 0 4>;
  nand-bus-width = <16>;
  ti,nand-ecc-opt = "bch4";
  ti,nand-xfer-type = "polled";
  gpmc,device-width = <2>;
  gpmc,cs-on-ns = <0>; gpmc,cs-rd-off-ns = <36>; gpmc,cs-wr-off-ns = <36>;
  gpmc,adv-on-ns = <6>; gpmc,adv-rd-off-ns = <24>; gpmc,adv-wr-off-ns = <36>;
  gpmc,oe-on-ns = <6>; gpmc,oe-off-ns = <48>; gpmc,we-on-ns = <6>; gpmc,we-off-ns = <30>;
  gpmc,rd-cycle-ns = <72>; gpmc,wr-cycle-ns = <72>; gpmc,access-ns = <54>; gpmc,wr-access-ns = <30>;
  partitions { compatible = "fixed-partitions"; #address-cells = <1>; #size-cells = <1>;
   partition@0 { label = "bootloader"; reg = <0 0x400000>; read-only; };
   partition@400000 { label = "kernel"; reg = <0x400000 0x800000>; };
   partition@c00000 { label = "rootfs"; reg = <0xc00000 0xf400000>; };
  };
 };
};

/ {
 aliases { display0 = &panel; };
 wlan_power: regulator-wlan {
  compatible = "regulator-fixed"; regulator-name = "wlan-power";
  regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>;
  gpio = <&gpio4 7 GPIO_ACTIVE_HIGH>; enable-active-high; startup-delay-us = <70000>;
 };
 piezo_amp: regulator-piezo {
  compatible = "regulator-fixed"; regulator-name = "piezo-amplifier";
  gpio = <&gpio2 26 GPIO_ACTIVE_LOW>;
 };
 piezo_pwm: pwm {
  compatible = "ti,omap-dmtimer-pwm"; ti,timers = <&timer11>;
  ti,clock-source = <0>; #pwm-cells = <3>;
 };
 beeper { compatible = "pwm-beeper"; pwms = <&piezo_pwm 0 1000000 0>; amp-supply = <&piezo_amp>; beeper-hz = <2000>; };

};
&gpio4 {
 wheel-shutdown { gpio-hog; gpios = <5 0>; output-low; line-name = "wheel-shutdown"; };
 wheel-reset { gpio-hog; gpios = <14 0>; output-high; line-name = "wheel-reset"; };
};
&vpll2 { regulator-always-on; };
&vaux2 { regulator-min-microvolt = <2800000>; regulator-max-microvolt = <2800000>; regulator-always-on; };
&i2c2 { clock-frequency = <400000>; status = "okay"; };
&i2c3 { clock-frequency = <400000>; status = "okay"; };
&mmc1 { status = "disabled"; };
&mmc2 {
 vmmc-supply = <&wlan_power>; bus-width = <4>; non-removable; cap-power-off-card;
 #address-cells = <1>; #size-cells = <0>; status = "okay";
 wifi@2 { compatible = "ti,wl1271"; reg = <2>; interrupt-parent = <&gpio4>;
  interrupts = <6 IRQ_TYPE_LEVEL_HIGH>; ref-clock-frequency = <26000000>;
 };
};
&dss { status = "okay"; port { dpi_out: endpoint { remote-endpoint = <&panel_in>; data-lines = <24>; }; }; };
&usb_otg_hs { mode = <2>; num-eps = <16>; ram-bits = <12>; dr_mode = "peripheral"; status = "okay"; };

&vmmc1 { regulator-min-microvolt = <3000000>; regulator-max-microvolt = <3000000>; regulator-always-on; };
/ { cpus { cpu@0 { cpu0-supply = <&vcc>; }; }; };

&mcspi1 {
 status = "okay";
 panel: panel@0 {
  compatible = "nestlabs,j49-panel"; reg = <0>;
  spi-max-frequency = <8000000>; spi-cpol; spi-cpha;
  reset-gpios = <&gpio4 13 GPIO_ACTIVE_LOW>;
  power-supply = <&vaux2>;
  backlight = <&backlight>;
  port { panel_in: endpoint { remote-endpoint = <&dpi_out>; }; };
 };
};
&i2c3 {
 backlight: backlight@36 {
  compatible = "nestlabs,j49-backlight"; reg = <0x36>;
  enable-gpios = <&gpio6 17 GPIO_ACTIVE_HIGH>;
 };
};

&omap3_pmx_core {
 pinctrl-names = "default"; pinctrl-0 = <&j49_pins &j49_io_pins>;
 j49_pins: j49-pins { pinctrl-single,pins = <
  OMAP3_CORE1_IOPAD(0x20d4, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_pclk */
  OMAP3_CORE1_IOPAD(0x20d6, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_hsync */
  OMAP3_CORE1_IOPAD(0x20d8, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_vsync */
  OMAP3_CORE1_IOPAD(0x20da, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_acbias */
  OMAP3_CORE1_IOPAD(0x20dc, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data0 */
  OMAP3_CORE1_IOPAD(0x20de, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data1 */
  OMAP3_CORE1_IOPAD(0x20e0, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data2 */
  OMAP3_CORE1_IOPAD(0x20e2, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data3 */
  OMAP3_CORE1_IOPAD(0x20e4, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data4 */
  OMAP3_CORE1_IOPAD(0x20e6, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data5 */
  OMAP3_CORE1_IOPAD(0x20e8, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data6 */
  OMAP3_CORE1_IOPAD(0x20ea, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data7 */
  OMAP3_CORE1_IOPAD(0x20ec, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data8 */
  OMAP3_CORE1_IOPAD(0x20ee, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data9 */
  OMAP3_CORE1_IOPAD(0x20f0, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data10 */
  OMAP3_CORE1_IOPAD(0x20f2, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data11 */
  OMAP3_CORE1_IOPAD(0x20f4, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data12 */
  OMAP3_CORE1_IOPAD(0x20f6, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data13 */
  OMAP3_CORE1_IOPAD(0x20f8, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data14 */
  OMAP3_CORE1_IOPAD(0x20fa, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data15 */
  OMAP3_CORE1_IOPAD(0x20fc, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data16 */
  OMAP3_CORE1_IOPAD(0x20fe, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data17 */
  OMAP3_CORE1_IOPAD(0x2100, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data18 */
  OMAP3_CORE1_IOPAD(0x2102, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data19 */
  OMAP3_CORE1_IOPAD(0x2104, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data20 */
  OMAP3_CORE1_IOPAD(0x2106, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data21 */
  OMAP3_CORE1_IOPAD(0x2108, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data22 */
  OMAP3_CORE1_IOPAD(0x210a, PIN_INPUT_PULLDOWN | MUX_MODE0) /* dss_data23 */
  OMAP3_CORE1_IOPAD(0x2158, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc2_clk */
  OMAP3_CORE1_IOPAD(0x215a, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc2_cmd */
  OMAP3_CORE1_IOPAD(0x215c, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc2_dat0 */
  OMAP3_CORE1_IOPAD(0x215e, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc2_dat1 */
  OMAP3_CORE1_IOPAD(0x2160, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc2_dat2 */
  OMAP3_CORE1_IOPAD(0x2162, PIN_INPUT_PULLUP | MUX_MODE0) /* sdmmc2_dat3 */
  OMAP3_CORE1_IOPAD(0x21ba, PIN_INPUT_PULLUP | MUX_MODE0) /* i2c1_scl */
  OMAP3_CORE1_IOPAD(0x21bc, PIN_INPUT_PULLUP | MUX_MODE0) /* i2c1_sda */
  OMAP3_CORE1_IOPAD(0x21be, PIN_INPUT_PULLUP | MUX_MODE0) /* i2c2_scl */
  OMAP3_CORE1_IOPAD(0x21c0, PIN_INPUT_PULLUP | MUX_MODE0) /* i2c2_sda */
  OMAP3_CORE1_IOPAD(0x21c2, PIN_INPUT_PULLUP | MUX_MODE0) /* i2c3_scl */
  OMAP3_CORE1_IOPAD(0x21c4, PIN_INPUT_PULLUP | MUX_MODE0) /* i2c3_sda */
  OMAP3_CORE1_IOPAD(0x2182, PIN_INPUT_PULLUP | MUX_MODE0) /* uart1_rx */
  OMAP3_CORE1_IOPAD(0x217c, PIN_OUTPUT | MUX_MODE0) /* uart1_tx */
  OMAP3_CORE1_IOPAD(0x21c8, PIN_INPUT | MUX_MODE0) /* mcspi1_clk */
  OMAP3_CORE1_IOPAD(0x21ca, PIN_OUTPUT | MUX_MODE0) /* mcspi1_simo */
  OMAP3_CORE1_IOPAD(0x21cc, PIN_INPUT | MUX_MODE0) /* mcspi1_somi */
  OMAP3_CORE1_IOPAD(0x21ce, PIN_INPUT_PULLDOWN | MUX_MODE0) /* mcspi1_cs0 */
  OMAP3_CORE1_IOPAD(0x21d4, PIN_OUTPUT | MUX_MODE4) /* mcspi1_cs3 */
  OMAP3_CORE1_IOPAD(0x211a, PIN_OUTPUT | MUX_MODE4) /* cam_d2 */
  OMAP3_CORE1_IOPAD(0x211c, PIN_INPUT_PULLUP | MUX_MODE4) /* cam_d3 */
  OMAP3_CORE1_IOPAD(0x211e, PIN_OUTPUT | MUX_MODE4) /* cam_d4 */
  OMAP3_CORE1_IOPAD(0x2128, PIN_INPUT | MUX_MODE4) /* cam_d9 */
  OMAP3_CORE1_IOPAD(0x212a, PIN_OUTPUT | MUX_MODE4) /* cam_d10 */
  OMAP3_CORE1_IOPAD(0x212c, PIN_OUTPUT | MUX_MODE4) /* cam_d11 */
  OMAP3_CORE1_IOPAD(0x20ba, PIN_OUTPUT | MUX_MODE3) /* gpmc_ncs6 */
  OMAP3_CORE1_IOPAD(0x20bc, PIN_OUTPUT | MUX_MODE4) /* gpmc_ncs7 */
  OMAP3_CORE1_IOPAD(0x21e0, PIN_INPUT_PULLUP | MUX_MODE0) /* sys_nirq */
 >; };
};

&usb_otg_hs { interface-type = <0>; usb-phy = <&usb2_phy>; phys = <&usb2_phy>; phy-names = "usb2-phy"; power = <50>; };
&twl_keypad { status = "disabled"; };

&twl_madc { vusb3v1-supply = <&vusb3v1>; };
&charger { status = "disabled"; };
/ {
 battery {
  compatible = "nestlabs,adc-battery";
  io-channels = <&twl_madc 0>; io-channel-names = "voltage";
  divider-r1-ohm = <2>; divider-r2-ohm = <1>;
 };
 twl4030_madc_hwmon { compatible = "nestlabs,j49-madc-hwmon";
  io-channels = <&twl_madc 0>, <&twl_madc 1>, <&twl_madc 2>, <&twl_madc 3>,
                <&twl_madc 4>, <&twl_madc 5>, <&twl_madc 6>, <&twl_madc 7>,
                <&twl_madc 8>, <&twl_madc 9>, <&twl_madc 10>, <&twl_madc 11>,
                <&twl_madc 12>, <&twl_madc 13>, <&twl_madc 14>, <&twl_madc 15>;
 };
};

&uart2 { status = "okay"; };
&uart3 { status = "okay"; };
&mcspi2 {
 status = "okay";
 radio@0 { compatible = "nestlabs,em357"; reg = <0>; spi-max-frequency = <20000000>; };
};
/ {
 aliases { serial-sensormcu0 = &uart3; };
 diamond-backplate {
  compatible = "nestlabs,gpio-exporter";
  input-names = "detect#"; input-gpios = <&gpio3 1 GPIO_ACTIVE_LOW>;
  output-names = "reset"; output-gpios = <&gpio4 8 GPIO_ACTIVE_HIGH>;
 };
 diamond-zigbee {
  compatible = "nestlabs,gpio-exporter";
  input-names = "interrupt"; input-gpios = <&gpio6 22 GPIO_ACTIVE_LOW>;
  output-names = "reset#"; output-gpios = <&gpio2 29 GPIO_ACTIVE_LOW>;
 };
 board-inputs {
  compatible = "nestlabs,gpio-exporter";
  input-names = "lcd-id", "wheel-motion#";
  input-gpios = <&gpio4 9 GPIO_ACTIVE_HIGH>, <&gpio4 12 GPIO_ACTIVE_LOW>;
 };
 diamond-battery {
  compatible = "nestlabs,gpio-exporter";
  output-names = "disconnect"; output-gpios = <&gpio6 1 GPIO_ACTIVE_HIGH>;
 };
};
&omap3_pmx_core {
 j49_io_pins: j49-io-pins { pinctrl-single,pins = <
  OMAP3_CORE1_IOPAD(0x219e, PIN_INPUT | MUX_MODE0) /* uart3_rx */
  OMAP3_CORE1_IOPAD(0x21a0, PIN_OUTPUT | MUX_MODE0) /* uart3_tx */
  OMAP3_CORE1_IOPAD(0x21d6, PIN_INPUT | MUX_MODE0) /* mcspi2_clk */
  OMAP3_CORE1_IOPAD(0x21d8, PIN_OUTPUT | MUX_MODE0) /* mcspi2_simo */
  OMAP3_CORE1_IOPAD(0x21da, PIN_INPUT | MUX_MODE0) /* mcspi2_somi */
  OMAP3_CORE1_IOPAD(0x21dc, PIN_OUTPUT | MUX_MODE0) /* mcspi2_cs0 */
  OMAP3_CORE1_IOPAD(0x21de, PIN_INPUT | MUX_MODE4) /* gpio182 radio_irq */
  OMAP3_CORE1_IOPAD(0x20c8, PIN_OUTPUT | MUX_MODE4) /* gpio61 radio_reset */
  OMAP3_CORE1_IOPAD(0x20d2, PIN_INPUT_PULLUP | MUX_MODE4) /* gpio65 backplate_detect */
  OMAP3_CORE1_IOPAD(0x2120, PIN_OUTPUT | MUX_MODE4) /* gpio104 backplate_reset */
  OMAP3_CORE1_IOPAD(0x2122, PIN_INPUT_PULLUP | MUX_MODE4) /* gpio105 lcd_id */
  OMAP3_CORE1_IOPAD(0x2196, PIN_OUTPUT | MUX_MODE4) /* gpio161 battery_disconnect */
 >; };
};
