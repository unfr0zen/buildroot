@@ -889,6 +890,16 @@
 		return;
 	}
 
+	if (r_rotate90->integer && !glState.currentFBO &&
+	    uniformNum == UNIFORM_MODELVIEWPROJECTIONMATRIX) {
+		Mat4Copy(matrix, rotated);
+		for (int column = 0; column < 4; column++) {
+			rotated[column * 4] = matrix[column * 4 + 1];
+			rotated[column * 4 + 1] = -matrix[column * 4];
+		}
+		matrix = rotated;
+	}
+
 	if (Mat4Compare(matrix, compare))
