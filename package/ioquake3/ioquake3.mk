IOQUAKE3_VERSION = 52088b9eae247d8e321c8dc1fb49a879652854f9
IOQUAKE3_SITE = $(call github,ioquake,ioq3,$(IOQUAKE3_VERSION))
IOQUAKE3_LICENSE = GPL-2.0-or-later
IOQUAKE3_LICENSE_FILES = COPYING.txt
IOQUAKE3_DEPENDENCIES = sdl2 libegl libgles jpeg zlib
IOQUAKE3_CONF_OPTS = \
 -DCMAKE_INSTALL_PREFIX=/usr/lib/ioquake3 \
 -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
 -DBUILD_SERVER=OFF -DBUILD_RENDERER_GL1=OFF \
 -DBUILD_GAME_QVMS=OFF -DBUILD_GAME_LIBRARIES=ON \
 -DUSE_RENDERER_DLOPEN=OFF -DUSE_INTERNAL_SDL=OFF \
 -DUSE_INTERNAL_JPEG=OFF -DUSE_INTERNAL_ZLIB=OFF \
 -DUSE_OPENAL=OFF -DUSE_HTTP=OFF -DUSE_CODEC_VORBIS=OFF \
 -DUSE_CODEC_OPUS=OFF -DUSE_VOIP=OFF -DUSE_MUMBLE=OFF

define IOQUAKE3_INSTALL_LAUNCHER
 $(INSTALL) -D -m 0644 $(IOQUAKE3_PKGDIR)/autoexec.cfg $(TARGET_DIR)/usr/lib/ioquake3/demoq3/autoexec.cfg
 $(INSTALL) -D -m 0755 $(IOQUAKE3_PKGDIR)/quake3 $(TARGET_DIR)/usr/bin/quake3
endef
IOQUAKE3_POST_INSTALL_TARGET_HOOKS += IOQUAKE3_INSTALL_LAUNCHER

$(eval $(cmake-package))
