#!/bin/sh
exec 9>/run/quake3.lock
if ! flock -n 9; then
 echo "Quake III is already running." >&2
 exit 1
fi
export SDL_VIDEODRIVER=kmsdrm
export SDL_KMSDRM_DEVICE_INDEX=0
export SDL_AUDIODRIVER=dummy
exec /usr/lib/ioquake3/ioquake3 \
 +set fs_basepath /usr/lib/ioquake3 +set fs_basegame demoq3 "$@"
